<?xml version="1.0" encoding="utf-8"?>
<!--
  Este archivo se copia tal cual al directorio de publicacion y sirve de base
  para que el modulo ASP.NET Core Hosting Bundle de IIS genere el web.config final
  (agregando el <aspNetCore> con la ruta del ejecutable, etc.).
  Se agrega aqui la remocion del modulo/handler WebDAV, que en muchos servidores IIS
  viene habilitado por defecto e intercepta los verbos PUT/DELETE devolviendo 405
  Method Not Allowed antes de que la request llegue a los controllers de ASP.NET Core.

  IMPORTANTE: debe existir un UNICO bloque <handlers> dentro de <system.webServer>.
  Si el hosting bundle agrega su propio <handlers> con el <add name="aspNetCore" .../>,
  hay que fusionarlo con el <remove name="WebDAV" /> en el mismo bloque (dos <handlers>
  separados en el mismo archivo son invalidos para IIS y provocan un 500 en toda la app).
-->
<configuration>
  <system.webServer>
	<modules>
	  <remove name="WebDAVModule" />
	</modules>
	<handlers>
	  <remove name="WebDAV" />
	</handlers>
  </system.webServer>
</configuration>
